# This profile exist to enable anonymous user namespaces, which Ubuntu-based distros default to off,
# and which QtWebEngine needs for sandboxing

abi <abi/4.0>,
include <tunables/global>

profile OptExample /opt/example/bin/example flags=(unconfined) {
  userns,
  # Site-specific additions and overrides. See local/README for details.
  include if exists <local/example>
}
